{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/skills/unslop/SKILL.md"
  ],
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
      },
      "models": {
        "gemma-4-26b-a4b-it-4bit": {
          "name": "Gemma 4 26B a4b 4bit (fast MoE vision)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "gemma-4-12b-it-8bit": {
          "name": "Gemma 4 12B 8bit (multimodal: text/image/audio/video)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "gemma-4-31b-it-4bit": {
          "name": "Gemma 4 31B 4bit (best reasoning + vision)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "ivrit-ai-whisper-large-v3-turbo-mlx": {
          "name": "Whisper v3 Turbo MLX (Hebrew ASR)",
          "modalities": {
            "input": [
              "audio"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 32000,
            "output": 4096
          }
        },
        "qwen2.5-coder-32b-instruct-4bit": {
          "name": "Qwen 2.5 Coder 32B 4bit (code gen + agents)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "qwen3.6-35b-a3b-4bit": {
          "name": "Qwen 3.6 35B A3B 4bit (reasoning + agentic MoE)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {}
    }
  },
  "permission": {
  },
  "command": {
    "usage": {
      "description": "Show monthly Claude API usage stats (cost, tokens, sessions)",
      "template": "Use the claude_usage tool to show my usage statistics for the past 3 months."
    }
  },
  "mcp": {
  },
  "plugin": [
    "@plannotator/opencode@latest",
    "@dietrichgebert/ponytail"
  ]
}
