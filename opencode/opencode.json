    "slack_slack_create_channel": "ask",
    "notion_*": "ask",
    "google-drive-and-email_*": "ask",
    "external_directory": {
      "/Users/alongat/Code/**": "allow",
      "*": "ask"
    }
  },
  "command": {
    "usage": {
      "description": "Show monthly Claude API usage stats (cost, tokens, sessions)",
      "template": "Use the claude_usage tool to show my usage statistics for the past 3 months."
    }
  },
  "mcp": {
    "incident.io": {
      "type": "remote",
      "url": "https://mcp.incident.io/mcp",
      "oauth": {},
      "enabled": false
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {},
      "enabled": false
    },
    "jellyfish": {
      "type": "local",
      "command": [
        "node",
        "/Users/alongat/.local/share/jellyfish-mcp/server/index.js"
      ],
      "enabled": false,
      "environment": {
        "JELLYFISH_API_TOKEN": "{env:JELLYFISH_API_TOKEN}"
      }
    },
    "finout": {
      "type": "remote",
      "url": "https://mcp.finout.io/mcp",
      "oauth": {},
      "enabled": false
    },
    "google-drive-and-email": {
      "type": "remote",
      "url": "{env:MCP_GDRIVE_URL}",
      "enabled": false
    },
    "atlassian": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/npx",
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/sse"
      ],
      "enabled": false
    },
    "metabase": {
      "type": "remote",
      "url": "https://metabase.torqio.dev/api/mcp",
      "oauth": {},
      "enabled": false
    },
    "slack": {
      "type": "remote",
      "url": "{env:MCP_SLACK_URL}",
      "oauth": {},
      "enabled": false
    },
    "slack-oauth": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "3660753192626.8903469228982"
      },
      "enabled": false
    }
  },
  "model": "omlx/gemma-4-26b-a4b-it-4bit",
  "plugin": [
    "@plannotator/opencode@latest"
  ]
}
