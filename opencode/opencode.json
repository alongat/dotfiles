{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
      },
      "models": {
        "gemma-4-26b-a4b-it-4bit": {
          "name": "Gemma 4 26B a4b 4bit (fast MoE vision)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "gemma-4-12b-it-8bit": {
          "name": "Gemma 4 12B 8bit (multimodal: text/image/audio/video)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "gemma-4-31b-it-4bit": {
          "name": "Gemma 4 31B 4bit (best reasoning + vision)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "ivrit-ai-whisper-large-v3-turbo-mlx": {
          "name": "Whisper v3 Turbo MLX (Hebrew ASR)",
          "modalities": {
            "input": [
              "audio"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 32000,
            "output": 4096
          }
        },
        "qwen2.5-coder-32b-instruct-4bit": {
          "name": "Qwen 2.5 Coder 32B 4bit (code gen + agents)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "qwen3.6-35b-a3b-4bit": {
          "name": "Qwen 3.6 35B A3B 4bit (reasoning + agentic MoE)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 128000,
            "output": 32768
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {}
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "incident_io_*": "ask",
    "incident_io_alert_list": "allow",
    "incident_io_alert_show": "allow",
    "incident_io_alert_source_list": "allow",
    "incident_io_alert_stats": "allow",
    "incident_io_analysis_start": "allow",
    "incident_io_ask": "allow",
    "incident_io_ask_incident": "allow",
    "incident_io_ask_telemetry": "allow",
    "incident_io_catalog_entry_list": "allow",
    "incident_io_catalog_entry_show": "allow",
    "incident_io_catalog_type_list": "allow",
    "incident_io_escalation_list": "allow",
    "incident_io_escalation_path_list": "allow",
    "incident_io_escalation_path_show": "allow",
    "incident_io_escalation_show": "allow",
    "incident_io_escalation_stats": "allow",
    "incident_io_feedback": "allow",
    "incident_io_follow_up_list": "allow",
    "incident_io_follow_up_stats": "allow",
    "incident_io_incident_list": "allow",
    "incident_io_incident_show": "allow",
    "incident_io_incident_stats": "allow",
    "incident_io_incident_update_list": "allow",
    "incident_io_investigation_sync": "allow",
    "incident_io_resource_list": "allow",
    "incident_io_resource_show": "allow",
    "incident_io_schedule_list": "allow",
    "incident_io_schedule_show": "allow",
    "incident_io_team_list": "allow",
    "incident_io_team_show": "allow",
    "atlassian_*": "ask",
    "atlassian_atlassianUserInfo": "allow",
    "atlassian_getAccessibleAtlassianResources": "allow",
    "atlassian_fetch": "allow",
    "atlassian_getConfluenceCommentChildren": "allow",
    "atlassian_getConfluencePage": "allow",
    "atlassian_getConfluencePageDescendants": "allow",
    "atlassian_getConfluencePageFooterComments": "allow",
    "atlassian_getConfluencePageInlineComments": "allow",
    "atlassian_getConfluenceSpaces": "allow",
    "atlassian_getIssueLinkTypes": "allow",
    "atlassian_getJiraIssue": "allow",
    "atlassian_getJiraIssueRemoteIssueLinks": "allow",
    "atlassian_getJiraIssueTypeMetaWithFields": "allow",
    "atlassian_getJiraProjectIssueTypesMetadata": "allow",
    "atlassian_getTransitionsForJiraIssue": "allow",
    "atlassian_getVisibleJiraProjects": "allow",
    "atlassian_lookupJiraAccountId": "allow",
    "atlassian_search": "allow",
    "atlassian_searchConfluenceUsingCql": "allow",
    "atlassian_searchJiraIssuesUsingJql": "allow",
    "slack_*": "ask",
    "slack_mcptotal_server_get_mandatory_instructions": "allow",
    "slack_mcptotal_share_resource": "allow",
    "slack_mcptotal_resume_approved_tool_call": "allow",
    "slack_slack_search_conversations": "allow",
    "slack_slack_search_messages": "allow",
