# OpenCode MCP secrets
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Jellyfish MCP (local server API token)
JELLYFISH_API_TOKEN=

# Slack MCP (remote URL — contains embedded auth token, get from mcptotal dashboard)
MCP_SLACK_URL=

# Google Drive & Email MCP (remote URL — contains embedded auth token, get from mcptotal dashboard)
MCP_GDRIVE_URL=
