#compdef ollama

# Zsh completion for ollama
# Supports: serve create show run stop pull push signin signout list ps cp rm launch
# Models are dynamically completed from 'ollama list' output

# ── Helpers ───────────────────────────────────────────────────────────────────

_ollama_models() {
  local -a models
  if command -v ollama &>/dev/null && curl -sf http://localhost:11434 &>/dev/null; then
    models=(${(f)"$(ollama list 2>/dev/null | awk 'NR>1 {print $1}')"})
  fi
  _describe 'local models' models
}

_ollama_running_models() {
  local -a models
  if command -v ollama &>/dev/null && curl -sf http://localhost:11434 &>/dev/null; then
    models=(${(f)"$(ollama ps 2>/dev/null | awk 'NR>1 {print $1}')"})
  fi
  _describe 'running models' models
}

# ── Subcommands ───────────────────────────────────────────────────────────────

_ollama_serve() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for serve]'
}

_ollama_create() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for create]' \
    '--experimental[enable experimental safetensors model creation]' \
    '(-f --file)'{-f,--file}'[name of the Modelfile]:Modelfile:_files' \
    '(-q --quantize)'{-q,--quantize}'[quantize model to this level (e.g. q4_K_M)]:level:(q4_K_M q4_K_S q5_K_M q5_K_S q8_0 f16)' \
    ':model name:'
}

_ollama_show() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for show]' \
    '--license[show license of a model]' \
    '--modelfile[show Modelfile of a model]' \
    '--parameters[show parameters of a model]' \
    '--system[show system message of a model]' \
    '--template[show template of a model]' \
    '(-v --verbose)'{-v,--verbose}'[show detailed model information]' \
    ':model:_ollama_models'
}

_ollama_run() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for run]' \
    '--dimensions[truncate output embeddings to specified dimension]:int:' \
    '--experimental[enable experimental agent loop with tools]' \
    '--experimental-websearch[enable web search tool in experimental mode]' \
    '--experimental-yolo[skip all tool approval prompts]' \
    '--format[response format]:format:(json)' \
    '--hidethinking[hide thinking output]' \
    '--insecure[use an insecure registry]' \
    '--keepalive[duration to keep a model loaded]:duration:(5m 10m 30m 1h)' \
    '--nowordwrap[do not wrap words to the next line automatically]' \
    '--think[enable thinking mode]:level:(true false high medium low)' \
    '--truncate[truncate inputs exceeding context length]' \
    '--verbose[show timings for response]' \
    '--width[image width]:int:' \
    '--height[image height]:int:' \
    '--steps[denoising steps]:int:' \
    '--seed[random seed]:int:' \
    '--negative[negative prompt]:str:' \
    ':model:_ollama_models' \
    '::prompt:'
}

_ollama_stop() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for stop]' \
    ':model:_ollama_running_models'
}

_ollama_pull() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for pull]' \
    '--insecure[use an insecure registry]' \
    ':model:'
}

_ollama_push() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for push]' \
    '--insecure[use an insecure registry]' \
    ':model:_ollama_models'
}

_ollama_cp() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for cp]' \
    ':source model:_ollama_models' \
    ':destination model:'
}

_ollama_rm() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for rm]' \
    '*:model:_ollama_models'
}

_ollama_list() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for list]'
}

_ollama_ps() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for ps]'
}

_ollama_signin() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for signin]'
}

_ollama_signout() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for signout]'
}

_ollama_launch() {
  _arguments \
    '(-h --help)'{-h,--help}'[help for launch]' \
    '--model[model to use]:model:_ollama_models' \
    ':integration:(claude opencode codex hermes openclaw)'
}

# ── Main dispatcher ───────────────────────────────────────────────────────────

_ollama() {
  local state

  _arguments \
    '(-h --help)'{-h,--help}'[help for ollama]' \
    '--nowordwrap[do not wrap words to the next line automatically]' \
    '--verbose[show timings for response]' \
    '(-v --version)'{-v,--version}'[show version information]' \
    '1: :->command' \
    '*:: :->args'

  case $state in
    command)
      local -a subcommands
      subcommands=(
        'serve:start Ollama'
        'create:create a model'
        'show:show information for a model'
        'run:run a model'
        'stop:stop a running model'
        'pull:pull a model from a registry'
        'push:push a model to a registry'
        'signin:sign in to ollama.com'
        'signout:sign out from ollama.com'
        'list:list models'
        'ps:list running models'
        'cp:copy a model'
        'rm:remove a model'
        'launch:launch the Ollama menu or an integration'
        'help:help about any command'
      )
      _describe 'ollama commands' subcommands
      ;;
    args)
      case $words[1] in
        serve)    _ollama_serve ;;
        create)   _ollama_create ;;
        show)     _ollama_show ;;
        run)      _ollama_run ;;
        stop)     _ollama_stop ;;
        pull)     _ollama_pull ;;
        push)     _ollama_push ;;
        signin)   _ollama_signin ;;
        signout)  _ollama_signout ;;
        list|ls)  _ollama_list ;;
        ps)       _ollama_ps ;;
        cp)       _ollama_cp ;;
        rm)       _ollama_rm ;;
        launch)   _ollama_launch ;;
        help)     _describe 'commands' subcommands ;;
      esac
      ;;
  esac
}

_ollama "$@"
